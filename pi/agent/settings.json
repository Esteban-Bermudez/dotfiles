{
  "lastChangelogVersion": "0.84.3",
  "theme": "light/dark",
  "defaultProvider": "opencode",
  "defaultModel": "muse-spark-1.2-contributor-free",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@fgladisch/pi-welcome-message",
    "npm:@tmustier/pi-usage-extension",
    "npm:@tifan/pi-rename",
    "npm:@senad-d/micme",
    "npm:pi-nvim",
    "npm:pi-code-previews",
    "npm:@latentminds/pi-quotas",
    "git:github.com/LoneExile/pi-output-styles"
  ],
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "httpIdleTimeoutMs": 60000,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enabledModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5",
    "openai-codex/gpt-5.6-terra",
    "opencode/deepseek-v4-flash-free",
    "anthropic/claude-haiku-4-5",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol"
  ],
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.config/zsh/.zshrc)\"",
  "hideThinkingBlock": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "regular"
}
