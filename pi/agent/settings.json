{
  "lastChangelogVersion": "0.87.0",
  "theme": "light/dark",
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-3.8-flash",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@fgladisch/pi-welcome-message",
    "npm:@senad-d/micme",
    "npm:pi-nvim",
    "npm:@latentminds/pi-quotas",
    "git:github.com/LoneExile/pi-output-styles",
    "npm:pi-memory",
    "npm:pi-session-auto-rename",
    "npm:@heyhuynhgiabuu/pi-oauth-antigravity"
  ],
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "httpIdleTimeoutMs": 60000,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enabledModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-haiku-4-5",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "antigravity/gemini-3.8-flash"
  ],
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.config/zsh/.zshrc)\"",
  "hideThinkingBlock": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "regular"
}
